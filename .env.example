# The environment of the data backend (spec §14).
#
# The names of the variables are the ones the service reads. A secret is
# never a value of the environment: it is a file, and the file is a mount
# of the secret manager of the deployment. The values of this file are
# the values of a development machine, and they are not secrets.

# The process.
DATA_HOST=127.0.0.1
DATA_PORT=8082
DATA_PROCESS_ROLE=all
DATA_ENVIRONMENT=development
DATA_LOG_LEVEL=info

# The database of the business data. The role is the one of the api: it
# reads and writes the rows of the scope of its transaction, and nothing
# else.
DATA_DATABASE_URL=postgres://data_runtime:dev-runtime-password-0001@127.0.0.1:5432/depot

# The narrow reader of the registry of the workspaces.
DATA_REGISTRY_DATABASE_URL=postgres://data_registry:dev-registry-password-0001@127.0.0.1:5432/depot

# The metadata of the deliveries. It is only needed when workers run.
DATA_DELIVERY_DATABASE_URL=postgres://data_delivery:dev-delivery-password-0001@127.0.0.1:5432/depot

# The trusted route bindings of the gateway.
DATA_SHUTTLE_BINDINGS_FILE=./config/bindings.json

# What the service does with the legacy verification of the identity:
# "refuse" (the default), "warn" or "allow". The legacy format is
# symmetric: the backend holds the derived secret of the gateway and it
# can sign an identity with it. It is refused, and it is removed in the
# version 2.0.0 of the service.
DATA_LEGACY_IDENTITY=refuse

# The artifacts of the deployment.
DATA_SCHEMA_BUNDLE_FILE=./manifests/schema.json
DATA_POLICY_BUNDLE_FILE=./manifests/policies.json

# The hub of the access context contract.
DATA_HUB_URL=http://127.0.0.1:8081
DATA_HUB_CONTEXT_TOKEN_FILE=./secrets/hub-context.token

# The key that signs the cursors. It is at least 32 bytes and it is not
# the key of the gateway.
DATA_CURSOR_KEY_FILE=./secrets/cursor.key

# The read only cache of the context, in milliseconds. It is zero by
# default: a mutation and a worker command always ask for a fresh one.
DATA_CONTEXT_CACHE_TTL_MS=0
DATA_HUB_TIMEOUT_MS=1000

# The budgets.
DATA_REQUEST_TIMEOUT_MS=10000
DATA_DB_STATEMENT_TIMEOUT_MS=3000
DATA_DB_TRANSACTION_TIMEOUT_MS=5000
DATA_DB_ACQUIRE_TIMEOUT_MS=1000
DATA_DB_POOL_MAX=20
DATA_MAX_BODY_BYTES=1048576
DATA_MAX_IN_FLIGHT_REQUESTS=200
DATA_DRAIN_MS=30000

# The worker.
DATA_WORKER_PRINCIPAL_ID=11111111-1111-4111-8111-111111111111
DATA_WORKER_ROUTE_ID=data-worker
DATA_WORKER_CONCURRENCY=4

# The metrics. Without the file the endpoint is absent.
DATA_METRICS_TOKEN_FILE=./secrets/metrics.token

# The operator commands. The owner of the schema and the administrator
# of the server are never used by the api.
DATA_ADMIN_DATABASE_URL=postgres://depot:depot@127.0.0.1:5432/postgres
DATA_OWNER_DATABASE_URL=postgres://data_owner:dev-owner-password-0001@127.0.0.1:5432/depot
DATA_OWNER_PASSWORD=dev-owner-password-0001
DATA_RUNTIME_PASSWORD=dev-runtime-password-0001
DATA_REGISTRY_PASSWORD=dev-registry-password-0001
DATA_DELIVERY_PASSWORD=dev-delivery-password-0001
DATA_MAINTENANCE_PASSWORD=dev-maintenance-password-0001
