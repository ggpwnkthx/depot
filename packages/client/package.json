{
  "name": "@data-backend/client",
  "version": "0.2.0",
  "type": "module",
  "description": "The typed client of the headless data backend.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ggpwnkthx/depot.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/ggpwnkthx/depot#readme",
  "bugs": {
    "url": "https://github.com/ggpwnkthx/depot/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./deployment": {
      "types": "./dist/deployment.d.ts",
      "import": "./dist/deployment.js",
      "default": "./dist/deployment.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "test": "bun test test",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "typescript": "5.9.3"
  },
  "files": [
    "dist"
  ]
}
