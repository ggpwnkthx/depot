{
  "version": 2,
  "bindings": [
    {
      "id": "data-api",
      "host": "api.shuttle.test",
      "upstreamPathPattern": "/ws/{workspaceId}/v1/*",
      "routeId": "data-api",
      "identity": {
        "version": "v5",
        "algorithm": "ES256",
        "publicKeyFile": "/run/secrets/identity.public.pem"
      }
    }
  ]
}
